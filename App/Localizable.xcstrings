      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fórmula"
          }
        }
      }
    },
    "Formula counts steps of the major scale from the root: ♭ lowers a step by a semitone, ♯ raises it. Fingers are for the right hand, thumb = 1; the left hand mirrors them, little finger on the lowest note." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fórmula conta os graus da escala maior a partir da fundamental: ♭ abaixa um grau em um semitom, ♯ eleva. Os dedos são da mão direita, polegar = 1; a mão esquerda espelha, com o dedo mínimo na nota mais grave."
          }
        }
      }
    },
