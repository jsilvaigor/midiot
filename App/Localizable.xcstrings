    "An inversion keeps the same notes and puts another one at the bottom. Inversions let the hand stay in one place while the chords change." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma inversão mantém as mesmas notas e põe outra delas embaixo. As inversões deixam a mão no mesmo lugar enquanto os acordes mudam."
          }
        }
      }
    },
